<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="clr-namespace:AvaloniaEdit.Editing;assembly=AvaloniaEdit">
  <Styles.Resources>
    <!-- Accent tokens. StudioThemeService overrides these at runtime (Application.Resources)
         when the user picks another accent theme; the values below are the Sprout defaults. -->
    <Color x:Key="SystemAccentColor">#4CD484</Color>
    <Color x:Key="SystemAccentColorLight1">#67DA95</Color>
    <Color x:Key="SystemAccentColorLight2">#82E1A8</Color>
    <Color x:Key="SystemAccentColorLight3">#A6EAC2</Color>
    <Color x:Key="SystemAccentColorDark1">#43BB74</Color>
    <Color x:Key="SystemAccentColorDark2">#37995F</Color>
    <Color x:Key="SystemAccentColorDark3">#2A7548</Color>
    <Color x:Key="StudioAccentColor">#4CD484</Color>
    <SolidColorBrush x:Key="StudioAccentBrush">#4CD484</SolidColorBrush>
    <SolidColorBrush x:Key="StudioAccentHoverBrush">#6BE39C</SolidColorBrush>
    <SolidColorBrush x:Key="StudioAccentPressedBrush">#41B470</SolidColorBrush>
    <SolidColorBrush x:Key="StudioAccentForegroundBrush">#09180F</SolidColorBrush>
    <SolidColorBrush x:Key="StudioAccentSoftBrush">#224CD484</SolidColorBrush>
    <SolidColorBrush x:Key="StudioAccentSofterBrush">#124CD484</SolidColorBrush>
    <SolidColorBrush x:Key="StudioAccentBorderBrush">#664CD484</SolidColorBrush>
    <SolidColorBrush x:Key="StudioSelectedBrush">#264CD484</SolidColorBrush>
    <SolidColorBrush x:Key="StudioSelectionBrush">#4A4CD484</SolidColorBrush>
    <SolidColorBrush x:Key="StudioCurrentLineBrush">#0C4CD484</SolidColorBrush>
    <RadialGradientBrush x:Key="StudioAccentGlowBrush">
      <GradientStop Color="#554CD484" Offset="0" />
      <GradientStop Color="#004CD484" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="StudioAccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#6BE39C" Offset="0" />
      <GradientStop Color="#3DAA6A" Offset="1" />
    </LinearGradientBrush>

    <!-- Neutral surfaces: a deep, slightly green-tinted graphite, layered from chrome to raised. -->
    <SolidColorBrush x:Key="StudioBackgroundBrush">#0A0D0C</SolidColorBrush>
    <SolidColorBrush x:Key="StudioChromeBrush">#0C100E</SolidColorBrush>
    <SolidColorBrush x:Key="StudioEditorBrush">#0F1312</SolidColorBrush>
    <SolidColorBrush x:Key="StudioPanelBrush">#111614</SolidColorBrush>
    <SolidColorBrush x:Key="StudioRaisedBrush">#171D1A</SolidColorBrush>
    <SolidColorBrush x:Key="StudioControlBrush">#1C2320</SolidColorBrush>
    <SolidColorBrush x:Key="StudioHoverBrush">#222A27</SolidColorBrush>
    <SolidColorBrush x:Key="StudioPressedBrush">#29322E</SolidColorBrush>
    <SolidColorBrush x:Key="StudioBorderBrush">#1F2724</SolidColorBrush>
    <SolidColorBrush x:Key="StudioStrongBorderBrush">#2E3834</SolidColorBrush>
    <SolidColorBrush x:Key="StudioSubtleBorderBrush">#0FFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="StudioTextPrimaryBrush">#E9EFEB</SolidColorBrush>
    <SolidColorBrush x:Key="StudioTextSecondaryBrush">#A8B4AE</SolidColorBrush>
    <SolidColorBrush x:Key="StudioTextMutedBrush">#6C7973</SolidColorBrush>
    <SolidColorBrush x:Key="StudioSuccessBrush">#5BD993</SolidColorBrush>
    <SolidColorBrush x:Key="StudioWarningBrush">#F0C05A</SolidColorBrush>
    <SolidColorBrush x:Key="StudioErrorBrush">#F2777E</SolidColorBrush>
    <SolidColorBrush x:Key="StudioInfoBrush">#6FB7FF</SolidColorBrush>
    <SolidColorBrush x:Key="StudioErrorSoftBrush">#22F2777E</SolidColorBrush>
    <SolidColorBrush x:Key="StudioWarningSoftBrush">#22F0C05A</SolidColorBrush>
    <SolidColorBrush x:Key="StudioInfoSoftBrush">#226FB7FF</SolidColorBrush>
    <SolidColorBrush x:Key="StudioIndentGuideBrush">#1CFFFFFF</SolidColorBrush>

    <!-- Fluent control resources re-pointed at the Studio palette. -->
    <StaticResource x:Key="ButtonBackground" ResourceKey="StudioControlBrush" />
    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="StudioHoverBrush" />
    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="StudioPressedBrush" />
    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="StudioControlBrush" />
    <StaticResource x:Key="ButtonForeground" ResourceKey="StudioTextPrimaryBrush" />
    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="StudioTextPrimaryBrush" />
    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="StudioTextPrimaryBrush" />
    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="StudioTextMutedBrush" />
    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="StudioStrongBorderBrush" />
    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="StudioStrongBorderBrush" />
    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="StudioStrongBorderBrush" />
    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="StudioBorderBrush" />
    <SolidColorBrush x:Key="TextControlBackground">#0D1110</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#101513</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackgroundFocused">#0D1110</SolidColorBrush>
    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="StudioStrongBorderBrush" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#3C4843</SolidColorBrush>
    <StaticResource x:Key="TextControlForeground" ResourceKey="StudioTextPrimaryBrush" />
    <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="StudioTextPrimaryBrush" />
    <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="StudioTextPrimaryBrush" />
    <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="StudioTextMutedBrush" />
    <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="StudioTextMutedBrush" />
    <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="StudioTextMutedBrush" />
    <SolidColorBrush x:Key="ComboBoxBackground">#0D1110</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver">#151B18</SolidColorBrush>
    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="StudioStrongBorderBrush" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver">#3C4843</SolidColorBrush>
    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="StudioRaisedBrush" />
    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="StudioStrongBorderBrush" />
    <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="StudioRaisedBrush" />
    <StaticResource x:Key="FlyoutBorderThemeBrush" ResourceKey="StudioStrongBorderBrush" />
    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="StudioRaisedBrush" />
    <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="StudioStrongBorderBrush" />
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
  </Styles.Resources>

  <!-- ============================================================ Base -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource StudioBackgroundBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioStrongBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource StudioControlBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.42" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{TemplateBinding Background}" />
    <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
  </Style>

  <!-- Primary (accent) buttons: filled with the theme accent, dark text. -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentForegroundBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent TextBlock.icon">
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentForegroundBrush}" />
  </Style>

  <!-- Ghost buttons: transparent until hovered. Shared by toolbar, icon, title and caption buttons. -->
  <Style Selector="Button.toolbar, Button.icon-button, Button.title-command, Button.caption, Button.tab-close,
                   Button.recent-project, Button.hyperlink, Button.toc-link, Button.activity, Button.status-item,
                   Button.academy-nav-btn, Button.academy-lang-btn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBox, ComboBox">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="SelectionBrush" Value="{DynamicResource StudioSelectionBrush}" />
  </Style>

  <Style Selector="ListBox, TreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="2" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioSelectedBrush}" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="4,0" />
  </Style>
  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot,
                   TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource StudioSelectedBrush}" />
  </Style>

  <!-- ============================================================ Shell surfaces -->
  <Style Selector="Border.title-surface">
    <Setter Property="Background" Value="{DynamicResource StudioChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.toolbar-surface">
    <Setter Property="Background" Value="{DynamicResource StudioChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="Border.activity-surface">
    <Setter Property="Background" Value="{DynamicResource StudioChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.pane-surface">
    <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}" />
  </Style>
  <Style Selector="Border.document-tab-surface, Border.bottom-surface">
    <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.breadcrumb-surface">
    <Setter Property="Background" Value="{DynamicResource StudioEditorBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.status-surface">
    <Setter Property="Background" Value="{DynamicResource StudioChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="Border.ready-pill">
    <Setter Property="Background" Value="{DynamicResource StudioAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.title-separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Background" Value="{DynamicResource StudioStrongBorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.toolbar-separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="Background" Value="{DynamicResource StudioStrongBorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Title bar command center: a search-like pill that opens the command palette. -->
  <Style Selector="Button.command-center">
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioStrongBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.command-center:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextPrimaryBrush}" />
  </Style>

  <!-- ============================================================ Toolbar -->
  <Style Selector="Button.toolbar">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.toolbar.project">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.toolbar.compact">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.toolbar.toggled">
    <Setter Property="Background" Value="{DynamicResource StudioAccentSofterBrush}" />
  </Style>
  <Style Selector="Button.toolbar.toggled TextBlock.icon">
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.toolbar-caption">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Segmented run group: one rounded capsule holding Run / Debug / Build. -->
  <Style Selector="Border.segment">
    <Setter Property="Background" Value="{DynamicResource StudioPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.segment Button.toolbar">
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Button.run-primary">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="12,0,14,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentForegroundBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.run-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentForegroundBrush}" />
  </Style>
  <Style Selector="Button.run-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentForegroundBrush}" />
  </Style>
  <Style Selector="Button.run-primary TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentForegroundBrush}" />
  </Style>

  <!-- ============================================================ Activity rail -->
  <Style Selector="Button.activity">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="48" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.activity:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Button.activity:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.activity Border.rail-icon">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.activity:pointerover Border.rail-icon">
    <Setter Property="Background" Value="{DynamicResource StudioHoverBrush}" />
  </Style>
  <Style Selector="Button.activity.selected Border.rail-icon">
    <Setter Property="Background" Value="{DynamicResource StudioAccentSoftBrush}" />
  </Style>
  <Style Selector="Button.activity.selected">
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentBrush}" />
  </Style>
  <Style Selector="Button.activity.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentBrush}" />
  </Style>
  <Style Selector="Button.activity Border.rail-pill">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="0,3,3,0" />
    <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
        <DoubleTransition Property="Height" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.activity:pointerover Border.rail-pill">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.activity.selected Border.rail-pill">
    <Setter Property="Height" Value="22" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBlock.activity-icon">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.activity-label">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ============================================================ Icons -->
  <Style Selector="TextBlock.icon, TextBlock.caption-icon">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.icon.small, TextBlock.caption-icon">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.icon.large">
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style Selector="TextBlock.icon.academy">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Width" Value="18" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.icon.academy-nav-icon">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Width" Value="20" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.icon.accent, TextBlock.sprout-file-icon">
    <Setter Property="Foreground" Value="{DynamicResource StudioAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.icon.muted">
    <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.icon.error">
    <Setter Property="Foreground" Value="{DynamicResource StudioErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.icon.warning">
    <Setter Property="Foreground" Value="{DynamicResource StudioWarningBrush}" />
  </Style>
  <Style Selector="TextBlock.sprout-file-icon">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.sprout-file-icon.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.explorer-icon">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.icon-button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.icon-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource StudioTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.icon-button.small">
    <Setter Property="Width" Value="25" />
    <Setter Property="Height" Value="24" />
  </Style>

  <Style Selector="Button.title-command">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.title-command:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource StudioTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
  </Style>
