  </Style>

  <Style Selector="ListBox.document-tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,0,0,0" />
  </Style>
  <Style Selector="ListBox.document-tabs ListBoxItem">
    <Setter Property="Height" Value="33" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="Margin" Value="0,5,2,0" />
    <Setter Property="CornerRadius" Value="8,8,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <Grid>
            <Border Name="PART_TabAccent" Height="2" VerticalAlignment="Top" Margin="8,0" CornerRadius="0,0,2,2" />
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.document-tabs ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource StudioRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
  </Style>
