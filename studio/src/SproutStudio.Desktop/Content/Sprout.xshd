<?xml version="1.0"?>
<SyntaxDefinition name="Sprout" extensions=".spr"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" fontStyle="italic" />
  <Color name="String" foreground="#D7A65A" />
  <Color name="Number" foreground="#A8D7A0" />
  <Color name="Keyword" foreground="#C792EA" fontWeight="bold" />
  <Color name="Literal" foreground="#71B7F2" />
  <Color name="BuiltIn" foreground="#65C7C9" />
  <Color name="Type" foreground="#D8C27A" />
  <RuleSet>
    <Span color="Comment" begin="#" />
    <Span color="String" begin="&quot;" end="&quot;" escapeCharacter="\" />
    <Keywords color="Keyword">
      <Word>has</Word>
      <Word>action</Word>
      <Word>class</Word>
      <Word>end</Word>
      <Word>if</Word>
      <Word>else</Word>
      <Word>repeat</Word>
      <Word>times</Word>
      <Word>while</Word>
      <Word>return</Word>
      <Word>import</Word>
      <Word>python</Word>
      <Word>as</Word>
      <Word>and</Word>
      <Word>or</Word>
      <Word>not</Word>
    </Keywords>
    <Keywords color="Literal">
      <Word>true</Word>
      <Word>false</Word>
      <Word>nil</Word>
    </Keywords>
    <Keywords color="Type">
      <Word>int</Word>
      <Word>float</Word>
      <Word>bool</Word>
      <Word>text</Word>
      <Word>auto</Word>
    </Keywords>
    <Keywords color="BuiltIn">
      <Word>print</Word>
      <Word>canvas_clear</Word>
      <Word>canvas_rect</Word>
      <Word>canvas_circle</Word>
    </Keywords>
    <Rule color="Number">\b(?:[0-9]+(?:\.[0-9]+)?)\b</Rule>
  </RuleSet>
</SyntaxDefinition>
