<UserControl
    x:Class="SproutStudio.Views.Shell.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:SproutStudio.Views.Shared"
    xmlns:vm="using:SproutStudio.ViewModels"
    x:DataType="vm:MainWindowViewModel">
  <Border Classes="status-surface">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,0">
      <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Border Classes="status-chip" Margin="0,0,6,0" ToolTip.Tip="{Binding EngineSummary}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <shared:SproutLogo Width="11" Height="11" />
            <TextBlock Text="{Binding EngineArchitecture}" />
          </StackPanel>
        </Border>
        <Button Classes="status-item" Command="{Binding ShowLearningProgressCommand}" Margin="0,0,4,0" IsVisible="{Binding ShowGamification}">
          <ToolTip.Tip>
            <StackPanel Spacing="3" MaxWidth="280">
              <TextBlock Text="Learning progress" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StreakTooltip}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DailyGoalText}" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="flame" Classes.cold="{Binding !HasStreak}" Width="10" Height="12" />
            <TextBlock Text="{Binding AcademyStreakDays}" Classes="status-text" FontWeight="SemiBold" />
            <Grid Width="12" Height="12" Margin="4,0,0,0" VerticalAlignment="Center">
              <Ellipse Classes="goal-track" StrokeThickness="2" />
              <Arc Classes="goal-ring" SweepAngle="{Binding DailyGoalSweep}" StrokeThickness="2" />
            </Grid>
            <TextBlock Text="{Binding DailyGoalText}" Classes="status-text" />
            <Border Classes="level-chip"><TextBlock Text="{Binding LevelBadgeText}" /></Border>
          </StackPanel>
        </Button>
        <Button Classes="status-item" Command="{Binding ShowSourceControlCommand}" IsVisible="{Binding HasSourceControl}" ToolTip.Tip="Source Control">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="icon small" Text="&#xE8F0;" />
            <TextBlock Text="{Binding GitBranch}" Classes="status-text" />
          </StackPanel>
        </Button>
        <Button Classes="status-item" Command="{Binding ShowProblemsCommand}" ToolTip.Tip="Show problems">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="icon small error" Text="&#xEA39;" />
            <TextBlock Text="{Binding ErrorCount}" Classes="status-text" />
            <TextBlock Classes="icon small warning" Text="&#xE7BA;" Margin="4,0,0,0" />
            <TextBlock Text="{Binding WarningCount}" Classes="status-text" />
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="7" Margin="8,0,0,0" VerticalAlignment="Center">
          <Ellipse Classes="status-dot" Classes.busy="{Binding IsBusy}" />
          <TextBlock Text="{Binding TaskText}" Classes="status-text" TextTrimming="CharacterEllipsis" MaxWidth="360" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button
            Classes="update-pill"
            IsVisible="{Binding HasUpdate}"
            Command="{Binding ShowUpdateDialogCommand}"
            ToolTip.Tip="Click to view update details and install">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Classes="icon small" Text="&#xE896;" />
            <TextBlock Text="{Binding UpdateBadgeText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button Classes="status-item" Command="{Binding GoToLineCommand}" ToolTip.Tip="Go to line (Ctrl+G)">
          <TextBlock Text="{Binding CaretStatus}" Classes="status-text" />
        </Button>
        <Button Classes="status-item" Command="{Binding ResetZoomCommand}" ToolTip.Tip="Editor zoom — click to reset (Ctrl+0)">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="icon small" Text="&#xE71E;" />
            <TextBlock Text="{Binding ZoomText}" Classes="status-text" />
          </StackPanel>
        </Button>
        <TextBlock Text="Spaces: 4" Classes="status-text" Margin="7,0" />
        <TextBlock Text="UTF-8" Classes="status-text" Margin="7,0" />
        <TextBlock Text="LF" Classes="status-text" Margin="7,0" />
        <TextBlock Text="{Binding CurrentLanguage}" Classes="status-text" Margin="7,0" />
        <Border Classes="status-chip" Margin="4,0,2,0">
          <TextBlock Text="{Binding CurrentProfile}" />
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
