<UserControl
    x:Class="SproutStudio.Views.Shell.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SproutStudio.ViewModels"
    x:DataType="vm:MainWindowViewModel">
  <Border Classes="status-surface">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
      <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
        <TextBlock Text="●" Foreground="{DynamicResource StudioAccentBrush}" FontSize="8" />
        <TextBlock Text="Sprout · READY" Foreground="{DynamicResource StudioSuccessBrush}" Classes="status-text" />
        <TextBlock Text="{Binding TaskText}" Foreground="{DynamicResource StudioTextSecondaryBrush}" Classes="status-text" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="{Binding CaretStatus}" Classes="status-text" />
        <TextBlock Text="Spaces: 4" Classes="status-text" />
        <TextBlock Text="UTF-8" Classes="status-text" />
        <TextBlock Text="LF" Classes="status-text" />
        <TextBlock Text="{Binding CurrentLanguage}" Classes="status-text" />
        <TextBlock Text="{Binding CurrentProfile}" Classes="status-text accent" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
