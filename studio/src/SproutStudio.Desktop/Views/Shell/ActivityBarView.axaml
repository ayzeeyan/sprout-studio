<UserControl
    x:Class="SproutStudio.Views.Shell.ActivityBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SproutStudio.ViewModels"
    x:DataType="vm:MainWindowViewModel">
  <Border Classes="activity-surface" IsVisible="{Binding ActivityVisible}">
    <Grid RowDefinitions="*,Auto">
      <StackPanel Margin="0,6">
        <Button Classes="activity" Classes.selected="{Binding IsExplorerSelected}" Command="{Binding ShowExplorerCommand}" ToolTip.Tip="Explorer (Ctrl+Shift+E)" ToolTip.Placement="Right">
          <Grid>
            <Border Classes="rail-pill" />
            <Border Classes="rail-icon"><TextBlock Classes="activity-icon" Text="&#xE8B7;" /></Border>
          </Grid>
        </Button>
        <Button Classes="activity" Classes.selected="{Binding IsSearchSelected}" Command="{Binding ShowSearchCommand}" ToolTip.Tip="Search (Ctrl+Shift+F)" ToolTip.Placement="Right">
          <Grid>
            <Border Classes="rail-pill" />
            <Border Classes="rail-icon"><TextBlock Classes="activity-icon" Text="&#xE721;" /></Border>
          </Grid>
        </Button>
        <Button Classes="activity" Classes.selected="{Binding IsSourceControlSelected}" Command="{Binding ShowSourceControlCommand}" ToolTip.Tip="Source Control (Ctrl+Shift+G)" ToolTip.Placement="Right">
          <Grid>
            <Border Classes="rail-pill" />
            <Border Classes="rail-icon"><TextBlock Classes="activity-icon" Text="&#xE8F0;" /></Border>
          </Grid>
        </Button>
        <Button Classes="activity" Classes.selected="{Binding IsAcademySelected}" Command="{Binding ShowAcademyCommand}" ToolTip.Tip="Academy" ToolTip.Placement="Right">
          <Grid>
            <Border Classes="rail-pill" />
            <Border Classes="rail-icon"><TextBlock Classes="activity-icon" Text="&#xE7BE;" /></Border>
          </Grid>
        </Button>
        <Button Classes="activity" Classes.selected="{Binding IsDocumentationSelected}" Command="{Binding ShowDocumentationCommand}" ToolTip.Tip="Documentation (F1)" ToolTip.Placement="Right">
          <Grid>
            <Border Classes="rail-pill" />
            <Border Classes="rail-icon"><TextBlock Classes="activity-icon" Text="&#xE82D;" /></Border>
          </Grid>
        </Button>
        <Button Classes="activity" Classes.selected="{Binding IsPackagesSelected}" Command="{Binding ShowPackagesCommand}" ToolTip.Tip="Packages" ToolTip.Placement="Right">
          <Grid>
            <Border Classes="rail-pill" />
            <Border Classes="rail-icon"><TextBlock Classes="activity-icon" Text="&#xE7B8;" /></Border>
          </Grid>
        </Button>
        <Button Classes="activity" Classes.selected="{Binding IsToolchainsSelected}" Command="{Binding ShowToolchainsCommand}" ToolTip.Tip="Languages &amp; Toolchains" ToolTip.Placement="Right">
          <Grid>
            <Border Classes="rail-pill" />
            <Border Classes="rail-icon"><TextBlock Classes="activity-icon" Text="&#xE943;" /></Border>
          </Grid>
        </Button>
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,6">
        <Button Classes="activity" Command="{Binding ToggleZenModeCommand}" ToolTip.Tip="Zen mode (F11)" ToolTip.Placement="Right">
          <Grid>
            <Border Classes="rail-pill" />
            <Border Classes="rail-icon"><TextBlock Classes="activity-icon" Text="&#xE740;" FontSize="16" /></Border>
          </Grid>
        </Button>
        <Button Classes="activity" Classes.selected="{Binding IsSettingsSelected}" Command="{Binding ShowSettingsCommand}" ToolTip.Tip="Settings (Ctrl+,)" ToolTip.Placement="Right">
          <Grid>
            <Border Classes="rail-pill" />
            <Border Classes="rail-icon"><TextBlock Classes="activity-icon" Text="&#xE713;" /></Border>
          </Grid>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
