<Window
    x:Class="SproutStudio.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:SproutStudio.Views.Shared"
    xmlns:vm="using:SproutStudio.ViewModels"
    xmlns:shell="using:SproutStudio.Views.Shell"
    xmlns:workspace="using:SproutStudio.Views.Workspace"
    xmlns:editor="using:SproutStudio.Views.Editor"
    xmlns:tools="using:SproutStudio.Views.Tools"
    xmlns:inspector="using:SproutStudio.Views.Inspector"
    xmlns:academy="using:SproutStudio.Views.Academy"
    x:DataType="vm:MainWindowViewModel"
    Title="Sprout Studio"
    Width="1440"
    Height="820"
    MinWidth="980"
    MinHeight="640"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="BorderOnly"
    Opened="MainWindow_Opened"
    Closing="MainWindow_Closing"
    SizeChanged="MainWindow_SizeChanged">

  <Grid RowDefinitions="38,46,*,26" Background="{DynamicResource StudioBackgroundBrush}">
    <Border Name="TitleBar" Grid.Row="0" Classes="title-surface" PointerPressed="TitleBar_PointerPressed" DoubleTapped="TitleBar_DoubleTapped">
      <Grid ColumnDefinitions="*,Auto,*,Auto,46,46,46">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10" VerticalAlignment="Center" Margin="16,0,14,0">
          <shared:SproutLogo Width="20" Height="20" />
          <TextBlock Grid.Column="1" Text="Sprout Studio" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Grid.Column="2" Classes="title-separator" />
          <TextBlock Grid.Column="3" Text="{Binding WindowContext}" Foreground="{DynamicResource StudioTextMutedBrush}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WindowContext}" />
        </Grid>

        <Button Name="CommandCenter" Grid.Column="1" Classes="command-center" Width="440" Command="{Binding CommandPaletteCommand}"
                ToolTip.Tip="Search commands and files (Ctrl+Shift+P)">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
            <TextBlock Classes="icon small" Text="&#xE721;" />
            <TextBlock Grid.Column="1" Text="{Binding CommandCenterText}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Name="CommandCenterHint" Grid.Column="2" Classes="kbd" Padding="5,0"><TextBlock Text="Ctrl+Shift+P" FontSize="9" /></Border>
          </Grid>
        </Button>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,6,0">
          <Button Classes="title-command" Command="{Binding ToggleExplorerCommand}" ToolTip.Tip="Toggle primary sidebar (Ctrl+B)">
            <TextBlock Classes="icon" Text="&#xE89F;" FontSize="14" />
          </Button>
          <Button Classes="title-command" Command="{Binding ToggleBottomPanelCommand}" ToolTip.Tip="Toggle panel (Ctrl+J)">
            <TextBlock Classes="icon" Text="&#xE8A0;" FontSize="14" RenderTransformOrigin="50%,50%">
              <TextBlock.RenderTransform><RotateTransform Angle="90" /></TextBlock.RenderTransform>
            </TextBlock>
          </Button>
          <Button Classes="title-command" Command="{Binding ToggleInspectorCommand}" ToolTip.Tip="Toggle inspector (Ctrl+Alt+B)">
            <TextBlock Classes="icon" Text="&#xE8A0;" FontSize="14" />
          </Button>
          <Border Classes="title-separator" Margin="6,0" />
          <Button Classes="title-command" Command="{Binding ShowAboutCommand}" ToolTip.Tip="About Sprout Studio">
            <TextBlock Classes="icon" Text="&#xE946;" FontSize="14" />
          </Button>
        </StackPanel>
        <Button Grid.Column="4" Classes="caption" Click="Minimize_Click" ToolTip.Tip="Minimize"><TextBlock Classes="caption-icon" Text="&#xE921;" /></Button>
        <Button Name="MaximizeButton" Grid.Column="5" Classes="caption" Click="Maximize_Click" ToolTip.Tip="Maximize">
          <TextBlock Name="MaximizeIcon" Classes="caption-icon" Text="&#xE922;" />
        </Button>
        <Button Grid.Column="6" Classes="caption close" Click="Close_Click" ToolTip.Tip="Close"><TextBlock Classes="caption-icon" Text="&#xE8BB;" /></Button>
      </Grid>
    </Border>

    <shell:MainToolbarView Grid.Row="1" />

    <Grid Name="ShellBodyGrid" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="56" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <shell:ActivityBarView Grid.Column="0" />

      <Grid Name="WorkspaceGrid" Grid.Column="1" IsVisible="{Binding IsWorkspaceMode}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280" MinWidth="0" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" MinWidth="420" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="360" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <workspace:ExplorerView Name="ExplorerPane" IsVisible="{Binding !IsAcademySelected}" />
          <academy:AcademySidebarView IsVisible="{Binding IsAcademySelected}" />
        </Grid>
        <GridSplitter Name="ExplorerSplitter" Grid.Column="1" Classes="pane-splitter" ResizeDirection="Columns" />

        <Grid Name="EditorToolGrid" Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="4" />
            <RowDefinition Height="220" MinHeight="0" />
          </Grid.RowDefinitions>
          <editor:EditorHostView Name="EditorHost" Grid.Row="0" />
          <GridSplitter Name="BottomSplitter" Grid.Row="1" Classes="pane-splitter" ResizeDirection="Rows" />
          <tools:BottomPanelView Grid.Row="2" />
        </Grid>

        <GridSplitter Name="InspectorSplitter" Grid.Column="3" Classes="pane-splitter" ResizeDirection="Columns" />
        <inspector:InspectorView Grid.Column="4" />
      </Grid>

      <ContentControl Name="StudioModeHost"
                      Grid.Column="1"
                      IsVisible="{Binding IsIntegratedMode}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
    </Grid>

    <shell:StatusBarView Grid.Row="3" />
  </Grid>
</Window>
