<UserControl
    x:Class="SproutStudio.Views.Inspector.InspectorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SproutStudio.ViewModels"
    xmlns:local="using:SproutStudio.Views.Inspector"
    xmlns:shared="using:SproutStudio.Views.Shared"
    x:DataType="vm:MainWindowViewModel">
  <Border Classes="pane-surface" IsVisible="{Binding InspectorVisible}">
    <Grid>
      <!-- Standard Inspector TabControl -->
      <TabControl Classes="inspector-tabs" SelectedIndex="{Binding SelectedInspectorTab, Mode=TwoWay}"
                  IsVisible="{Binding !IsAcademySelected}">
        <TabItem Header="Learn">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Margin="14,12,14,8" Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Classes="icon accent" Text="&#xE7BE;" FontSize="14" />
                <TextBlock Text="CONCEPTS IN THIS FILE" Classes="panel-header" />
              </StackPanel>
              <TextBlock Text="{Binding LearnHeaderText}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource StudioTextMutedBrush}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding LearnConcepts}" Margin="12,0,12,12">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:LearnConceptViewModel">
                    <Border Classes="learn-card">
                      <StackPanel Spacing="7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding UsageText}" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                        <Border Classes="code-snippet" ClipToBounds="True">
                          <shared:HighlightedCode Code="{Binding Evidence}" Language="{Binding LanguageKey}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Examples}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:LearnExampleViewModel">
                              <StackPanel Spacing="3" Margin="0,2,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <shared:LanguageIconView LanguageKey="{Binding LanguageKey}" Width="13" Height="13" />
                                  <TextBlock Text="{Binding Language, StringFormat='In {0}'}" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" />
                                </StackPanel>
                                <Border Classes="code-snippet">
                                  <shared:HighlightedCode Code="{Binding Code}" Language="{Binding LanguageKey}" TextWrapping="Wrap" />
                                </Border>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                          <TextBlock Classes="icon small" Text="&#xE73E;" Foreground="{DynamicResource StudioSuccessBrush}" IsVisible="{Binding Practiced}" />
                          <TextBlock Classes="icon small" Text="&#xE7BE;" Foreground="{DynamicResource StudioTextMutedBrush}" IsVisible="{Binding !Practiced}" />
                          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                     Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button Classes="hyperlink" FontSize="11" Content="Guide" IsVisible="{Binding HasGuide}" ToolTip.Tip="{Binding GuideTooltip}"
                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenGuideCommand}"
                                    CommandParameter="{Binding GuideId}" />
                            <Button Classes="hyperlink" FontSize="11" Content="Concept"
                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenConceptCommand}"
                                    CommandParameter="{Binding ConceptId}" ToolTip.Tip="Open in the Academy Concept Browser" />
                            <Button Classes="accent" Height="24" MinHeight="0" Padding="9,0" FontSize="11" Content="{Binding PracticeLabel}"
                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).PracticeConceptCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>
        <TabItem Header="Variables">
          <Grid RowDefinitions="34,30,*,34,30,*">
            <TextBlock Classes="panel-header" Text="WATCH / VARIABLES" Margin="12,0" />
            <Grid Grid.Row="1" ColumnDefinitions="*,100,*" Margin="12,0">
              <TextBlock Classes="table-header" Text="Name" />
              <TextBlock Grid.Column="1" Classes="table-header" Text="Type" />
              <TextBlock Grid.Column="2" Classes="table-header" Text="Value" />
            </Grid>
            <Grid Grid.Row="2">
              <TextBlock IsVisible="{Binding NoDebugVariables}" Text="Start debugging to inspect variables." Classes="empty-state" />
              <ListBox IsVisible="{Binding HasDebugVariables}" ItemsSource="{Binding DebugVariables}">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:DebugVariableViewModel">
                    <Grid ColumnDefinitions="*,100,*" Margin="12,5">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding TypeName}" Foreground="{DynamicResource StudioTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <TextBlock Grid.Row="3" Classes="panel-header section" Text="CALL STACK" Margin="12,0" />
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="12,0">
              <TextBlock Classes="table-header" Text="Frame" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasDebugSnapshots}">
                <Button Classes="icon-button small" Command="{Binding PreviousDebugSnapshotCommand}" ToolTip.Tip="Previous step"><TextBlock Classes="icon small" Text="&#xE76B;" /></Button>
                <TextBlock Text="{Binding DebugSnapshotNumber}" VerticalAlignment="Center" />
                <TextBlock Text="/" VerticalAlignment="Center" Foreground="{DynamicResource StudioTextMutedBrush}" />
                <TextBlock Text="{Binding DebugSnapshotCount}" VerticalAlignment="Center" />
                <Button Classes="icon-button small" Command="{Binding NextDebugSnapshotCommand}" ToolTip.Tip="Next step"><TextBlock Classes="icon small" Text="&#xE76C;" /></Button>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="5">
              <TextBlock IsVisible="{Binding NoDebugFrames}" Text="No call stack available." Classes="empty-state" />
              <ListBox IsVisible="{Binding HasDebugFrames}" ItemsSource="{Binding DebugFrames}">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:DebugFrameViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="12,5">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Location}" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Debug" ToolTip.Tip="Debugger: recorded snapshots and breakpoints">
          <Grid RowDefinitions="38,Auto,38,Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0">
              <TextBlock Classes="panel-header" Text="BREAKPOINTS" />
              <Button Grid.Column="1" Classes="toolbar compact" Command="{Binding ToggleBreakpointCommand}" Content="Toggle at caret" />
            </Grid>
            <Grid Grid.Row="1" MinHeight="60">
              <TextBlock IsVisible="{Binding NoBreakpoints}" Text="No breakpoints set." Classes="empty-state" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14" />
              <ListBox IsVisible="{Binding HasBreakpoints}" ItemsSource="{Binding Breakpoints}" MaxHeight="160">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:BreakpointViewModel">
                    <Grid ColumnDefinitions="24,*,Auto" Margin="10,5">
                      <TextBlock Text="●" Foreground="{DynamicResource StudioErrorBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding FileName}" />
                      <TextBlock Grid.Column="2" Text="{Binding Line}" FontFamily="Cascadia Mono, Consolas" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
            <TextBlock Grid.Row="2" Classes="panel-header section" Text="DEBUG SESSION" Margin="12,0" />
            <StackPanel Grid.Row="3" Margin="12,6,12,16" Spacing="8">
              <TextBlock Text="Use Debug to run through real interpreter snapshots." TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding DebugCommand}" Classes="accent" Content="Start Debugging" />
                <Button Command="{Binding ToggleBreakpointCommand}" Content="Toggle Breakpoint" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </TabItem>

        <TabItem Header="Outline">
          <Grid>
            <TextBlock IsVisible="{Binding ShowWelcome}" Text="Open a document to view its symbols." Classes="empty-state" />
            <ListBox IsVisible="{Binding HasDocuments}" ItemsSource="{Binding OutlineItems}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:OutlineItemViewModel">
                  <Grid ColumnDefinitions="24,*,Auto" Margin="8,4">
                    <TextBlock Text="◇" Foreground="{DynamicResource StudioAccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="{DynamicResource StudioTextMutedBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <TabItem Header="AST" ToolTip.Tip="Abstract syntax tree graph">
          <local:ASTGraphView DataContext="{Binding AstGraph}" />
        </TabItem>

        <TabItem Header="Info" ToolTip.Tip="Document properties">
          <Grid RowDefinitions="38,*">
            <TextBlock Classes="panel-header" Text="DOCUMENT" Margin="12,0" />
            <Grid Grid.Row="1" ColumnDefinitions="90,*" RowDefinitions="30,30,30,30,Auto" Margin="12,4">
              <TextBlock Classes="table-header" Text="Name" />
              <TextBlock Grid.Column="1" Text="{Binding SelectedDocument.DisplayName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1" Classes="table-header" Text="Language" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentLanguage}" />
              <TextBlock Grid.Row="2" Classes="table-header" Text="Profile" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentProfile}" />
              <TextBlock Grid.Row="3" Classes="table-header" Text="Engine" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EngineVersion}" />
              <TextBlock Grid.Row="4" Classes="table-header" Text="Path" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDocument.FilePath}" TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Canvas">
          <Grid Margin="10">
            <Border Background="{DynamicResource StudioEditorBrush}" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
              <local:CanvasPreviewControl Commands="{Binding CanvasCommands}" MinHeight="220" />
            </Border>
            <TextBlock IsVisible="{Binding NoCanvasCommands}" Text="Run canvas_clear, canvas_rect, or canvas_circle to draw."
                       Classes="empty-state" Margin="22" TextWrapping="Wrap" />
          </Grid>
        </TabItem>
      </TabControl>

      <!-- ACADEMY PROGRESS View when Academy is selected -->
      <local:AcademyProgressView IsVisible="{Binding IsAcademySelected}" />
    </Grid>
  </Border>
</UserControl>
