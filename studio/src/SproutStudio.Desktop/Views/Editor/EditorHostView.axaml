<UserControl
    x:Class="SproutStudio.Views.Editor.EditorHostView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    xmlns:shared="using:SproutStudio.Views.Shared"
    xmlns:local="using:SproutStudio.Views.Editor"
    xmlns:vm="using:SproutStudio.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    x:CompileBindings="False">
  <Grid Background="{DynamicResource StudioEditorBrush}">
    <Grid IsVisible="{Binding HasDocuments}" RowDefinitions="38,Auto,*">
      <Border Classes="document-tab-surface">
        <ListBox Classes="document-tabs"
                 ItemsSource="{Binding Documents}"
                 SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:DocumentTabViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7" MinWidth="120" MaxWidth="240">
                <shared:LanguageIconView LanguageKey="{Binding LanguageKey}" Width="16" Height="16" />
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Ellipse Grid.Column="2" Classes="dirty-dot" IsVisible="{Binding IsDirty}" ToolTip.Tip="Unsaved changes" />
                <Button Grid.Column="3" Classes="tab-close" Command="{Binding CloseCommand}" ToolTip.Tip="Close (Ctrl+W)">
                  <TextBlock Classes="icon small" Text="&#xE711;" FontSize="10" />
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Row="1" Classes="breadcrumb-surface" Height="26" IsVisible="{Binding SelectedDocument.IsSource}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" Margin="12,0" VerticalAlignment="Center">
          <shared:LanguageIconView LanguageKey="{Binding SelectedDocument.LanguageKey}" Width="16" Height="16" />
          <TextBlock Grid.Column="1" Text="{Binding SelectedDocument.Breadcrumb}" Foreground="{DynamicResource StudioTextSecondaryBrush}"
                     FontSize="11" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <!-- Side-by-Side Split Workspace Mode for Academy Exercise & Companion Code -->
        <Grid IsVisible="{Binding SelectedDocument.IsAcademyCoding}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="300" MaxWidth="420" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="320" />
          </Grid.ColumnDefinitions>

          <!-- Left Side: Interactive Exercise Guide -->
          <Border Grid.Column="0" ClipToBounds="True">
            <local:AcademyDocumentView DataContext="{Binding SelectedDocument.AcademyTab}" />
          </Border>

          <GridSplitter Grid.Column="1" Classes="pane-splitter" ResizeDirection="Columns" />

          <!-- Right Side: Real Code Editor for Companion File -->
          <Grid Grid.Column="2" RowDefinitions="28,*">
            <Border Classes="breadcrumb-surface">
              <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="Academy workspace" Foreground="{DynamicResource StudioTextMutedBrush}" FontSize="11" />
                <TextBlock Grid.Column="1" Text="›" Foreground="{DynamicResource StudioTextMutedBrush}" FontSize="11" />
                <shared:LanguageIconView Grid.Column="2" LanguageKey="{Binding SelectedDocument.LanguageKey}" Width="15" Height="15" />
                <TextBlock Grid.Column="3" Text="{Binding SelectedDocument.AcademyTab.LinkedCompanionName}" FontWeight="SemiBold"
                           Foreground="{DynamicResource StudioTextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>

            <ae:TextEditor Grid.Row="1"
                           Name="AcademyCompanionEditor"
                           ShowLineNumbers="True"
                           FontFamily="Cascadia Mono, CaskaydiaCove Nerd Font Mono, Consolas"
                           FontSize="{Binding EditorFontSize}"
                           WordWrap="{Binding EditorWordWrap}"
                           Background="{DynamicResource StudioEditorBrush}"
                           Foreground="{DynamicResource StudioTextPrimaryBrush}"
                           LineNumbersForeground="{DynamicResource StudioTextMutedBrush}"
                          
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"
                           Padding="10,8"
                           KeyDown="CodeEditor_KeyDown" />
          </Grid>
        </Grid>

        <Grid IsVisible="{Binding SelectedDocument.IsAcademySolo}">
          <local:AcademyDocumentView DataContext="{Binding SelectedDocument.AcademyTab}" />
        </Grid>

        <!-- Standard Single Source Code Editor Mode -->
        <Grid IsVisible="{Binding SelectedDocument.IsSource}">
          <ae:TextEditor Name="CodeEditor"
                         ShowLineNumbers="True"
                         FontFamily="Cascadia Mono, CaskaydiaCove Nerd Font Mono, Consolas"
                         FontSize="{Binding EditorFontSize}"
                         WordWrap="{Binding EditorWordWrap}"
                         Background="{DynamicResource StudioEditorBrush}"
                         Foreground="{DynamicResource StudioTextPrimaryBrush}"
                         LineNumbersForeground="{DynamicResource StudioTextMutedBrush}"
                        
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Padding="10,8"
                         KeyDown="CodeEditor_KeyDown" />

          <Border Name="FindPanel" Classes="find-panel" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,18,0">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox Name="FindTextBox" Width="220" PlaceholderText="Find" KeyDown="FindTextBox_KeyDown" />
                <Button Classes="icon-button" Click="FindPrevious_Click" ToolTip.Tip="Previous match"><TextBlock Classes="icon" Text="&#xE70E;" /></Button>
                <Button Classes="icon-button" Click="FindNext_Click" ToolTip.Tip="Next match"><TextBlock Classes="icon" Text="&#xE70D;" /></Button>
                <Button Classes="icon-button" Click="CloseFind_Click" ToolTip.Tip="Close"><TextBlock Classes="icon" Text="&#xE711;" /></Button>
              </StackPanel>
              <StackPanel Name="ReplaceRow" Orientation="Horizontal" Spacing="6" IsVisible="False">
                <TextBox Name="ReplaceTextBox" Width="220" PlaceholderText="Replace" KeyDown="ReplaceTextBox_KeyDown" />
                <Button Content="Replace" Classes="toolbar compact" Click="Replace_Click" />
                <Button Content="All" Classes="toolbar compact" Click="ReplaceAll_Click" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Name="GoToLinePanel" Classes="palette-surface" IsVisible="False" HorizontalAlignment="Center"
                  VerticalAlignment="Top" Margin="0,10,0,0" Width="380" Padding="10">
            <StackPanel Spacing="7">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Classes="icon accent" Text="&#xE8AD;" />
                <TextBox Grid.Column="1" Name="GoToLineTextBox" PlaceholderText="Go to line (e.g. 42 or 42:7)"
                         KeyDown="GoToLineTextBox_KeyDown" LostFocus="GoToLineTextBox_LostFocus" />
              </Grid>
              <TextBlock Name="GoToLineHint" FontSize="11" Foreground="{DynamicResource StudioTextMutedBrush}" />
            </StackPanel>
          </Border>

          <Border Name="HoverPanel" Classes="editor-hover" IsVisible="False" IsHitTestVisible="False"
                  HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="420">
            <StackPanel Spacing="4">
              <TextBlock Name="HoverTitle" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
              <TextBlock Name="HoverContents" TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Grid IsVisible="{Binding ShowWelcome}" ClipToBounds="True">
      <!-- Soft accent glow behind the hero. -->
      <Ellipse Width="760" Height="460" Fill="{DynamicResource StudioAccentGlowBrush}" Opacity="0.55"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-250,0,0" IsHitTestVisible="False" />
      <ScrollViewer Padding="28,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    SizeChanged="WelcomeScroll_SizeChanged">
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="0" MaxWidth="760" Margin="0,36">
          <!-- Hero -->
          <Border Width="76" Height="76" CornerRadius="22" HorizontalAlignment="Center"
                  Background="{DynamicResource StudioRaisedBrush}" BorderBrush="{DynamicResource StudioStrongBorderBrush}"
                  BorderThickness="1" BoxShadow="0 14 40 0 #77000000">
            <shared:SproutLogo Width="46" Height="46" />
          </Border>
          <TextBlock Classes="eyebrow" Text="SPROUT STUDIO · WINDOWS X64" HorizontalAlignment="Center" Margin="0,20,0,6" />
          <TextBlock Classes="hero-title" Text="Start growing something" HorizontalAlignment="Center" />
          <TextBlock Text="Create a project, open an existing one, or learn the language in Academy. Diagnostics, a recorded debugger, and the Sprout runtime are built in."
                     TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" Margin="0,8,0,0" LineHeight="19"
                     Foreground="{DynamicResource StudioTextSecondaryBrush}" />

          <!-- Quick actions -->
          <Grid Name="WelcomeCards" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,26,0,0">
            <Button Classes="quick-card primary" Command="{Binding NewProjectCommand}">
              <StackPanel Spacing="8">
                <Border Classes="card-icon" HorizontalAlignment="Left"><TextBlock Classes="icon" Text="&#xE8F4;" /></Border>
                <TextBlock Classes="card-title" Text="New project" />
                <TextBlock Classes="card-text" Text="Guided, Structured, or Advanced templates." />
              </StackPanel>
            </Button>
            <Button Classes="quick-card" Command="{Binding OpenProjectCommand}">
              <StackPanel Spacing="8">
                <Border Classes="card-icon" HorizontalAlignment="Left"><TextBlock Classes="icon" Text="&#xE838;" /></Border>
                <TextBlock Classes="card-title" Text="Open project" />
                <TextBlock Classes="card-text" Text="Pick a folder containing sprout.toml." />
              </StackPanel>
            </Button>
            <Button Classes="quick-card" Command="{Binding NewDocumentCommand}">
              <StackPanel Spacing="8">
                <Border Classes="card-icon" HorizontalAlignment="Left"><TextBlock Classes="icon" Text="&#xE710;" /></Border>
                <TextBlock Classes="card-title" Text="Scratch file" />
                <TextBlock Classes="card-text" Text="Try an idea in a new untitled file. Ctrl+N" />
              </StackPanel>
            </Button>
            <Button Classes="quick-card" Command="{Binding ShowAcademyCommand}">
              <StackPanel Spacing="8">
                <Border Classes="card-icon" HorizontalAlignment="Left"><TextBlock Classes="icon" Text="&#xE7BE;" /></Border>
                <TextBlock Classes="card-title" Text="Learn in Academy" />
                <TextBlock Classes="card-text" Text="Lessons, challenges, and progress tracking." />
              </StackPanel>
            </Button>
            <Button Classes="quick-card" Command="{Binding ShowDocumentationCommand}">
              <StackPanel Spacing="8">
                <Border Classes="card-icon" HorizontalAlignment="Left"><TextBlock Classes="icon" Text="&#xE82D;" /></Border>
                <TextBlock Classes="card-title" Text="Documentation" />
                <TextBlock Classes="card-text" Text="Grammar, stdlib, and Studio guides offline. F1" />
              </StackPanel>
            </Button>
            <Button Classes="quick-card" Command="{Binding OpenReplCommand}">
              <StackPanel Spacing="8">
                <Border Classes="card-icon" HorizontalAlignment="Left"><TextBlock Classes="icon" Text="&#xE756;" /></Border>
                <TextBlock Classes="card-title" Text="Sprout REPL" />
                <TextBlock Classes="card-text" Text="Evaluate expressions interactively." />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Recent projects + shortcuts -->
          <Grid ColumnDefinitions="3*,2*" ColumnSpacing="10" Margin="5,16,5,0">
            <Border Classes="dialog-card" Padding="12,10">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="RECENT PROJECTS" Classes="panel-header" />
                  <Button Grid.Column="1" Classes="hyperlink" Command="{Binding OpenProjectCommand}" FontSize="11" Content="Browse…" />
                </Grid>
                <TextBlock IsVisible="{Binding !HasRecentProjects}" Text="Projects you open will appear here for quick access."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource StudioTextMutedBrush}" Margin="0,8" />
                <ScrollViewer IsVisible="{Binding HasRecentProjects}" MaxHeight="190"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding RecentProjects}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:RecentProjectViewModel">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="0,1" Opacity="{Binding RowOpacity}">
                          <Button Classes="recent-project" Command="{Binding $parent[UserControl].DataContext.OpenRecentProjectCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="{Binding ToolTip}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                              <Border Classes="card-icon" Width="30" Height="30" CornerRadius="8">
                                <TextBlock Classes="icon" Text="&#xE8B7;" FontSize="13" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding RootPath}" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" TextTrimming="PathSegmentEllipsis" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                          <Button Grid.Column="1" Classes="icon-button small" Command="{Binding $parent[UserControl].DataContext.RemoveRecentProjectCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Remove from recent projects">
                            <TextBlock Classes="icon small" Text="&#xE711;" FontSize="9" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="dialog-card" Padding="12,10">
              <StackPanel Spacing="8">
                <TextBlock Text="KEYBOARD" Classes="panel-header" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Command palette" FontSize="11.5" Foreground="{DynamicResource StudioTextSecondaryBrush}" /><Border Grid.Column="1" Classes="kbd"><TextBlock Text="Ctrl+Shift+P" /></Border></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Run / Debug" FontSize="11.5" Foreground="{DynamicResource StudioTextSecondaryBrush}" /><Border Grid.Column="1" Classes="kbd"><TextBlock Text="F5 / F6" /></Border></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Go to line" FontSize="11.5" Foreground="{DynamicResource StudioTextSecondaryBrush}" /><Border Grid.Column="1" Classes="kbd"><TextBlock Text="Ctrl+G" /></Border></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Toggle comment" FontSize="11.5" Foreground="{DynamicResource StudioTextSecondaryBrush}" /><Border Grid.Column="1" Classes="kbd"><TextBlock Text="Ctrl+/" /></Border></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Zoom editor" FontSize="11.5" Foreground="{DynamicResource StudioTextSecondaryBrush}" /><Border Grid.Column="1" Classes="kbd"><TextBlock Text="Ctrl+= / Ctrl+-" /></Border></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Zen mode" FontSize="11.5" Foreground="{DynamicResource StudioTextSecondaryBrush}" /><Border Grid.Column="1" Classes="kbd"><TextBlock Text="F11" /></Border></Grid>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
