<Window
    x:Class="SproutStudio.Views.Dialogs.MessageDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False"
    Width="470"
    SizeToContent="Height"
    MinHeight="190"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">
  <Grid RowDefinitions="Auto,*,Auto" Margin="22">
    <TextBlock Name="Heading" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Name="Message" Grid.Row="1" Margin="0,14,0,22" TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="CancelButton" Click="Cancel_Click" Content="Cancel" MinWidth="86" />
      <Button Name="AcceptButton" Click="Accept_Click" Classes="accent" MinWidth="96" />
    </StackPanel>
  </Grid>
</Window>
