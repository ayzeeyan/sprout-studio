<UserControl
    x:Class="SproutStudio.Views.Academy.AcademyModeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SproutStudio.Views.Academy"
    xmlns:shared="using:SproutStudio.Views.Shared"
    x:CompileBindings="False"
    SizeChanged="AcademyModeView_SizeChanged">
  <Grid RowDefinitions="58,*" Background="{DynamicResource StudioBackgroundBrush}">
    <Border Classes="mode-header">
      <Grid ColumnDefinitions="*,Auto" Margin="18,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Sprout Academy" Classes="mode-title" />
          <TextBlock Text="Learn concepts across languages, then practice in the real Studio."
                     Foreground="{DynamicResource StudioTextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Reference Docs" Click="OpenDocs_Click" />
          <Button Content="Refresh" Click="Refresh_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Name="AcademyBodyGrid" Grid.Row="1" ColumnDefinitions="190,1,*,1,230">
      <Grid RowDefinitions="42,*" Margin="6">
        <TextBlock Text="ACADEMY" Classes="panel-header" Margin="10,0" />
        <ListBox Name="AcademyNavigation" Grid.Row="1" SelectionChanged="AcademyNavigation_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="local:AcademySectionItem">
              <Grid ColumnDefinitions="28,*" Margin="8,7">
                <TextBlock Text="{Binding Glyph}" Classes="icon academy-nav-icon" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Border Grid.Column="1" Background="{DynamicResource StudioBorderBrush}" />

      <Grid Grid.Column="2">
        <ScrollViewer Name="HomePanel"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      SizeChanged="ConstrainedScroll_SizeChanged">
          <StackPanel MaxWidth="900" Spacing="16" Margin="24,18,30,42">
            <StackPanel>
              <TextBlock Name="WelcomeTitle" Text="Continue learning" FontSize="23" FontWeight="SemiBold" />
              <TextBlock Text="Your Academy progress is stored locally on this device."
                         Foreground="{DynamicResource StudioTextSecondaryBrush}" />
            </StackPanel>

            <!-- 1. CONTINUE LEARNING -->
            <Border Classes="academy-feature">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="18" ColumnSpacing="14">
                <shared:LanguageIconView Name="ContinueLanguageIcon" Width="42" Height="42" />
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="CONTINUE LEARNING" Classes="panel-header" FontSize="11" />
                  <TextBlock Name="ContinueTrackTitle" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Name="ContinueLessonTitle" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                  <ProgressBar Name="ContinueProgress" Height="5" Maximum="100" />
                  <TextBlock Name="ContinueProgressText" FontSize="11" Foreground="{DynamicResource StudioTextMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Name="ContinueButton" Classes="accent" Content="Continue Lesson" Click="Continue_Click" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- 2. TO DO SYSTEM -->
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="TO DO" Classes="panel-header" VerticalAlignment="Center" />
                <TextBlock Name="TodoCountText" Grid.Column="1" Text="3 tasks" FontSize="11" Foreground="{DynamicResource StudioTextMutedBrush}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Name="TodoEmptyText" Text="All caught up! Select a track below to start your next lesson."
                         Classes="empty-state" IsVisible="False" Margin="0,4" />
              <ItemsControl Name="HomeTodoList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="local:AcademyTaskRow">
                    <Border Classes="academy-row" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,10" ColumnSpacing="12">
                        <TextBlock Text="{Binding StatusGlyph}" Classes="icon academy" Foreground="{Binding StatusBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <Border Classes="badge" Background="{DynamicResource StudioPanelBrush}" CornerRadius="3" Padding="6,1">
                              <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                          <TextBlock Text="{Binding RequirementText}" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{Binding ActionLabel}" Tag="{Binding}" Click="OpenTask_Click" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- 3. YOUR COURSES -->
            <StackPanel Spacing="8">
              <TextBlock Text="YOUR COURSES" Classes="panel-header" />
              <ItemsControl Name="HomeCoursesList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="local:AcademyTrackRow">
                    <Border Classes="academy-row" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,*,120,Auto" Margin="12,9" ColumnSpacing="12">
                        <shared:LanguageIconView LanguageKey="{Binding LanguageKey}" Width="30" Height="30" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding NextLessonLabel}" FontSize="11" Foreground="{DynamicResource StudioTextMutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                          <ProgressBar Maximum="100" Value="{Binding CompletionPercent}" Height="4" />
                          <TextBlock Text="{Binding ProgressLabel}" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource StudioTextMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="3" Content="Open" Tag="{Binding Id}" Click="ViewTrack_Click" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- 4. HINTS & LEARNING ASSISTANCE WIDGET -->
            <Border Classes="academy-row">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,12" ColumnSpacing="14">
                <Border Width="34" Height="34" CornerRadius="6" Background="{DynamicResource StudioRaisedBrush}">
                  <TextBlock Classes="icon accent" Text="&#xEA80;" FontSize="20"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="LEARNING ASSISTANCE &amp; HINTS" Classes="panel-header" FontSize="11" />
                  <TextBlock Name="HomeHintsRemainingText" Text="5 of 5 hints remaining today" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Name="HomeHintsDots" Text="● ● ● ● ●" Foreground="{DynamicResource StudioAccentBrush}" FontSize="13" />
                    <TextBlock Name="HomeHintsResetText" Text="Resets tomorrow · Local calendar day" FontSize="11" Foreground="{DynamicResource StudioTextMutedBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Content="Hint Settings" Click="HintSettings_Click" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- 5. RECENT SUBMISSIONS -->
            <StackPanel Spacing="8">
              <TextBlock Text="RECENT SUBMISSIONS" Classes="panel-header" />
              <TextBlock Name="SubmissionsEmptyText" Text="No submissions yet. Submit code or quiz answers in your lessons to track attempts."
                         Classes="empty-state" IsVisible="False" Margin="0,4" />
              <ItemsControl Name="HomeRecentSubmissions">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="local:AcademySubmissionRow">
                    <Border Classes="academy-row" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="12,10" ColumnSpacing="12">
                        <TextBlock Text="{Binding StatusGlyph}" Classes="icon academy" Foreground="{Binding StatusBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding ExerciseTitle}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                          <TextBlock Text="{Binding FeedbackSummary}" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                          <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" FontSize="11" HorizontalAlignment="Right" />
                          <TextBlock Text="{Binding DateLabel}" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Button Grid.Column="3" Content="Review" Tag="{Binding}" Click="ReviewSubmission_Click" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- 6. RECOMMENDED NEXT -->
            <TextBlock Text="EXPLORE MORE TRACKS" Classes="panel-header" Margin="0,4,0,0" />
            <ItemsControl Name="HomeRecommendations">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="local:AcademyRecommendationRow">
                  <Border Classes="academy-row" Margin="0,0,0,7">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12" ColumnSpacing="11">
                      <shared:LanguageIconView LanguageKey="{Binding LanguageKey}" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="View track" Tag="{Binding TrackId}" Click="ViewTrack_Click" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Grid Name="MyLearningPanel" IsVisible="False" RowDefinitions="Auto,*" Margin="24,18,30,30">
          <StackPanel>
            <TextBlock Text="My Learning" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="Active tracks, current progress, and the next lesson."
                       Foreground="{DynamicResource StudioTextSecondaryBrush}" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Name="MyLearningEmpty" Text="No active tracks yet. Choose Learning Tracks to enroll."
                       Classes="empty-state" />
            <ListBox Name="MyLearningList" IsVisible="False">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="local:AcademyTrackRow">
                  <Border Classes="academy-row" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,100,Auto" Margin="13" ColumnSpacing="12">
                      <shared:LanguageIconView LanguageKey="{Binding LanguageKey}" Width="34" Height="34" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NextLessonLabel}" Foreground="{DynamicResource StudioTextMutedBrush}" />
                        <TextBlock Text="{Binding ToolchainLabel}" FontSize="10" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                        <ProgressBar Maximum="100" Value="{Binding CompletionPercent}" Height="5" />
                        <TextBlock Text="{Binding ProgressLabel}" HorizontalAlignment="Right" FontSize="10" />
                      </StackPanel>
                      <Button Grid.Column="3" Content="Continue" Tag="{Binding Id}" Click="ViewTrack_Click" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>

        <Grid Name="TracksPanel" IsVisible="False" ColumnDefinitions="300,1,*">
          <Grid RowDefinitions="42,*" Margin="8">
            <TextBlock Text="LEARNING TRACKS" Classes="panel-header" Margin="8,0" />
            <ListBox Name="TrackList" Grid.Row="1" SelectionChanged="TrackList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="local:AcademyTrackRow">
                  <Grid ColumnDefinitions="Auto,*" Margin="6,8" ColumnSpacing="11">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource StudioRaisedBrush}"
                            BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                      <shared:LanguageIconView LanguageKey="{Binding LanguageKey}" Width="22" Height="22" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding ToolchainLabel}" FontSize="10.5" Foreground="{DynamicResource StudioTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" FontSize="10.5" Foreground="{DynamicResource StudioAccentBrush}" />
                      </Grid>
                      <ProgressBar Maximum="100" Value="{Binding CompletionPercent}" Height="3" Margin="0,1,0,0" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <Border Grid.Column="1" Background="{DynamicResource StudioBorderBrush}" />
          <ScrollViewer Name="TrackDetailScroll" Grid.Column="2"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        SizeChanged="ConstrainedScroll_SizeChanged">
            <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Stretch" Margin="22,18,28,42">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource StudioRaisedBrush}"
                        BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1">
                  <shared:LanguageIconView Name="TrackLanguageIcon" Width="36" Height="36" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                  <TextBlock Name="SelectedTrackTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <Border Classes="status-badge" HorizontalAlignment="Left">
                    <TextBlock Name="SelectedTrackStatus" />
                  </Border>
                </StackPanel>
                <Button Name="EnrollButton" Grid.Column="2" Classes="accent" Click="Enroll_Click" VerticalAlignment="Center" Padding="16,0" />
              </Grid>
              <TextBlock Name="SelectedTrackSummary" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"
                         Foreground="{DynamicResource StudioTextSecondaryBrush}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <ProgressBar Name="SelectedTrackProgress" Height="6" Maximum="100" VerticalAlignment="Center" />
                <TextBlock Name="SelectedTrackProgressText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource StudioTextMutedBrush}" />
              </Grid>
              <Border Name="PrerequisitePanel" Classes="academy-prerequisite" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto" Margin="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Toolchain prerequisite" FontWeight="SemiBold" />
                    <TextBlock Name="PrerequisiteText" TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Open Toolchains" Click="OpenToolchains_Click" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ItemsControl Name="ModuleList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="local:AcademyModuleRow">
                    <StackPanel Spacing="9" Margin="0,0,0,18">
                      <Grid ColumnDefinitions="*,120" ColumnSpacing="16">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding ModuleLabel}" Classes="panel-header" />
                          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                     Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Bottom">
                          <TextBlock Text="{Binding ProgressLabel}" HorizontalAlignment="Right" FontSize="10"
                                     Foreground="{DynamicResource StudioTextMutedBrush}" />
                          <ProgressBar Maximum="100" Value="{Binding CompletionPercent}" Height="4" />
                        </StackPanel>
                      </Grid>

                      <ItemsControl ItemsSource="{Binding Lessons}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="local:AcademyLessonRow">
                            <Border Classes="lesson-row" Margin="0,0,0,8">
                              <Grid ColumnDefinitions="*,Auto" Margin="13" ColumnSpacing="12">
                                <StackPanel Spacing="5">
                                  <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="{Binding StateGlyph}" Classes="icon academy" Foreground="{DynamicResource StudioAccentBrush}" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  </StackPanel>
                                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                                  <TextBlock Text="{Binding Content}" TextWrapping="Wrap" MaxHeight="64" Foreground="{DynamicResource StudioTextMutedBrush}" />
                                  <TextBlock Text="{Binding ConceptsLabel}" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                  <TextBlock Text="{Binding XpLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource StudioAccentBrush}" />
                                  <Button Content="{Binding CompletionLabel}" IsVisible="{Binding ShowCompleteAction}" IsEnabled="{Binding CanComplete}" Click="CompleteLesson_Click" />
                                  <Button Content="{Binding WorkspaceActionLabel}" IsVisible="{Binding CanPractice}" Click="Practice_Click" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Border Classes="academy-row" IsVisible="{Binding HasCheckpoint}">
                        <Grid DataContext="{Binding Checkpoint}" ColumnDefinitions="Auto,*,Auto" Margin="13,11" ColumnSpacing="11">
                          <TextBlock Text="{Binding StateGlyph}" Classes="icon academy"
                                     Foreground="{DynamicResource StudioAccentBrush}" />
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="MODULE CHECKPOINT" Classes="panel-header" FontSize="10" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding QuestionLabel}" FontSize="10"
                                         Foreground="{DynamicResource StudioTextMutedBrush}" />
                              <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                         Foreground="{DynamicResource StudioAccentBrush}" />
                            </StackPanel>
                          </StackPanel>
                          <Button Grid.Column="2" Content="{Binding ActionLabel}" IsEnabled="{Binding CanOpen}"
                                  Click="OpenCheckpoint_Click" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Grid Name="ConceptsPanel" IsVisible="False" ColumnDefinitions="270,1,*">
          <Grid RowDefinitions="42,34,*" Margin="8">
            <TextBlock Text="CONCEPT BROWSER" Classes="panel-header" Margin="8,0" />
            <TextBox Name="ConceptSearchBox" Grid.Row="1" PlaceholderText="Search concepts or languages" TextChanged="ConceptSearch_TextChanged" />
            <ListBox Name="ConceptList" Grid.Row="2" Margin="0,8,0,0" SelectionChanged="ConceptList_SelectionChanged" DisplayMemberBinding="{Binding Title}" />
          </Grid>
          <Border Grid.Column="1" Background="{DynamicResource StudioBorderBrush}" />
          <ScrollViewer Name="ConceptDetailScroll" Grid.Column="2"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        SizeChanged="ConstrainedScroll_SizeChanged">
            <StackPanel Spacing="10" MaxWidth="760" Margin="22,18,28,42">
              <TextBlock Name="ConceptTitle" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Name="ConceptSummary" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
              <TextBlock Name="RelatedConceptsText" TextWrapping="Wrap" Foreground="{DynamicResource StudioAccentBrush}" />
              <TextBlock Text="COMPARE LANGUAGES" Classes="panel-header" Margin="0,10,0,0" />
              <ItemsControl Name="ConceptExamples">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="local:AcademyConceptExampleRow">
                    <Border Classes="academy-code" Margin="0,0,0,8">
                      <Grid RowDefinitions="34,*">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0" VerticalAlignment="Center">
                          <shared:LanguageIconView LanguageKey="{Binding LanguageKey}" Width="22" Height="22" />
                          <TextBlock Text="{Binding Language}" FontWeight="SemiBold" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                          <SelectableTextBlock Text="{Binding Code}" Margin="12,9,12,12" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                        </ScrollViewer>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <ScrollViewer Name="ChallengesPanel" IsVisible="False"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      SizeChanged="ConstrainedScroll_SizeChanged">
          <StackPanel MaxWidth="900" Spacing="14" Margin="24,18,30,42">
            <StackPanel Spacing="3">
              <TextBlock Text="Challenges" FontSize="23" FontWeight="SemiBold" />
              <TextBlock Text="Continue graded exercises, revisions, and unlocked checkpoints across your enrolled tracks."
                         TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
            </StackPanel>
            <TextBlock Name="ChallengesEmptyText" Text="No active challenges. Enroll in a track or review a completed activity."
                       Classes="empty-state" IsVisible="False" Margin="0,12" />
            <ItemsControl Name="ChallengeList">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="local:AcademyTaskRow">
                  <Border Classes="academy-row" Margin="0,0,0,7">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="13,11" ColumnSpacing="12">
                      <TextBlock Text="{Binding StatusGlyph}" Classes="icon academy" Foreground="{Binding StatusBrush}" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <Border Classes="badge" Padding="6,1">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="{DynamicResource StudioTextMutedBrush}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                        <TextBlock Text="{Binding RequirementText}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource StudioTextMutedBrush}" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="{Binding ActionLabel}" Tag="{Binding}" Click="OpenTask_Click" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="SubmissionsPanel" IsVisible="False"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      SizeChanged="ConstrainedScroll_SizeChanged">
          <StackPanel MaxWidth="900" Spacing="14" Margin="24,18,30,42">
            <StackPanel Spacing="3">
              <TextBlock Text="Submissions" FontSize="23" FontWeight="SemiBold" />
              <TextBlock Text="Official attempts are recorded here. Sandbox test runs never appear in this history."
                         TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
            </StackPanel>
            <TextBlock Name="SubmissionListEmptyText" Text="No official submissions yet. Open an exercise and choose Submit when you are ready."
                       Classes="empty-state" IsVisible="False" Margin="0,12" />
            <ItemsControl Name="SubmissionList">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="local:AcademySubmissionRow">
                  <Border Classes="academy-row" Margin="0,0,0,7">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="13,11" ColumnSpacing="12">
                      <TextBlock Text="{Binding StatusGlyph}" Classes="icon academy" Foreground="{Binding StatusBrush}" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding ExerciseTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                        <TextBlock Text="{Binding FeedbackSummary}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource StudioTextMutedBrush}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                        <TextBlock Text="{Binding DateLabel}" FontSize="10" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource StudioTextMutedBrush}" />
                      </StackPanel>
                      <Button Grid.Column="3" Content="Review" Tag="{Binding}" Click="ReviewSubmission_Click" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="ProfilePanel" IsVisible="False"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      SizeChanged="ConstrainedScroll_SizeChanged">
          <Grid ColumnDefinitions="*,1,*" MaxWidth="900" ColumnSpacing="24" Margin="24,18,30,42">
            <StackPanel Spacing="9">
              <TextBlock Text="Learner Profile" FontSize="23" FontWeight="SemiBold" />
              <TextBlock Text="Used only for transparent local recommendations."
                         Foreground="{DynamicResource StudioTextSecondaryBrush}" />
              <TextBlock Text="Display name" Classes="table-header" />
              <TextBox Name="DisplayNameBox" />
              <TextBlock Text="Preferred username" Classes="table-header" />
              <TextBox Name="UsernameBox" />
              <TextBlock Text="Experience" Classes="table-header" />
              <ComboBox Name="ExperienceBox" HorizontalContentAlignment="Stretch" />
              <TextBlock Text="Goals" Classes="table-header" />
              <UniformGrid Columns="2" Rows="3">
                <CheckBox Name="GoalGeneral" Content="General programming" />
                <CheckBox Name="GoalGames" Content="Game development" />
                <CheckBox Name="GoalBackend" Content="Web / backend" />
                <CheckBox Name="GoalAi" Content="AI / automation" />
                <CheckBox Name="GoalCs" Content="Computer science" />
                <CheckBox Name="GoalSystems" Content="Systems programming" />
              </UniformGrid>
              <CheckBox Name="GamificationBox" Content="Show levels, XP, and achievements" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="Save Profile" Click="SaveProfile_Click" />
                <TextBlock Name="ProfileStatusText" VerticalAlignment="Center" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource StudioBorderBrush}" />
            <StackPanel Grid.Column="2" Spacing="10">
              <TextBlock Text="Achievements" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Name="AchievementEmpty" Text="Complete lessons to earn meaningful milestones."
                         Classes="empty-state" Margin="0,20" />
              <ItemsControl Name="AchievementList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="academy-row" Margin="0,0,0,7">
                      <TextBlock Text="{Binding}" Margin="12,9" TextWrapping="Wrap" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>

      <Border Grid.Column="3" Background="{DynamicResource StudioBorderBrush}" />

      <ScrollViewer Name="AcademyProgressPanel" Grid.Column="4">
        <StackPanel Margin="16" Spacing="12">
          <TextBlock Text="YOUR PROGRESS" Classes="panel-header" />
          <TextBlock Name="LevelText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource StudioAccentBrush}" />
          <TextBlock Name="XpText" FontSize="14" />
          <ProgressBar Name="LevelProgress" Height="6" Maximum="100" />
          <TextBlock Name="LessonCountText" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
          <TextBlock Name="ActiveTrackCountText" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
          <TextBlock Text="TOOLCHAINS" Classes="panel-header" Margin="0,12,0,0" />
          <ItemsControl Name="AcademyToolchains">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="local:AcademyToolchainRow">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4" ColumnSpacing="8">
                  <shared:LanguageIconView LanguageKey="{Binding LanguageKey}" Width="24" Height="24" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" FontSize="10"
                             Foreground="{DynamicResource StudioTextMutedBrush}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Manage Toolchains" Click="OpenToolchains_Click" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
