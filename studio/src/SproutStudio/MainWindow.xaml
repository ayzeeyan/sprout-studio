<Window
    x:Class="SproutStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:SproutStudio.Shell"
    xmlns:workspace="using:SproutStudio.Workspace"
    xmlns:studioEditor="using:SproutStudio.Editor"
    xmlns:tools="using:SproutStudio.Tools"
    xmlns:inspector="using:SproutStudio.Inspector"
    mc:Ignorable="d"
    Title="Sprout Studio">

    <Grid x:Name="RootLayout"
          RequestedTheme="Dark"
          Background="{StaticResource StudioBackgroundBrush}"
          SizeChanged="RootLayout_SizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="CommandPaletteAccelerator_Invoked" />
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="ExplorerAccelerator_Invoked" />
            <KeyboardAccelerator Key="J" Modifiers="Control" Invoked="BottomPanelAccelerator_Invoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewDocumentAccelerator_Invoked" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenDocumentAccelerator_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveDocumentAccelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="RunAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <shell:StudioTitleBar x:Name="StudioTitle" Grid.Row="0" />

        <Grid x:Name="ApplicationBody" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ActivityColumn" Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <shell:ActivityBar x:Name="ActivityRail" Grid.Column="0" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" MinHeight="240" />
                    <RowDefinition x:Name="BottomSplitterRow" Height="4" />
                    <RowDefinition x:Name="BottomPanelRow" Height="190" />
                </Grid.RowDefinitions>

                <shell:MainToolbar x:Name="Toolbar" Grid.Row="0" />

                <Grid x:Name="MainWorkspaceGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ExplorerColumn" Width="280" />
                        <ColumnDefinition x:Name="ExplorerSplitterColumn" Width="4" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition x:Name="InspectorSplitterColumn" Width="4" />
                        <ColumnDefinition x:Name="InspectorColumn" Width="350" />
                    </Grid.ColumnDefinitions>

                    <workspace:ExplorerView x:Name="ExplorerPane" Grid.Column="0" />
                    <shell:PaneSplitter x:Name="ExplorerSplitter"
                                        Grid.Column="1"
                                        Orientation="Vertical"
                                        DragDelta="ExplorerSplitter_DragDelta" />
                    <studioEditor:EditorHost x:Name="EditorPane" Grid.Column="2" />
                    <shell:PaneSplitter x:Name="InspectorSplitter"
                                        Grid.Column="3"
                                        Orientation="Vertical"
                                        DragDelta="InspectorSplitter_DragDelta" />
                    <inspector:InspectorView x:Name="InspectorPane" Grid.Column="4" />
                </Grid>

                <shell:PaneSplitter x:Name="BottomSplitter"
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    DragDelta="BottomSplitter_DragDelta" />
                <tools:BottomToolPanel x:Name="BottomPane" Grid.Row="3" />
            </Grid>
        </Grid>

        <shell:StatusBar x:Name="StudioStatus" Grid.Row="2" />
    </Grid>
</Window>
