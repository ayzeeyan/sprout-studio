<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="StudioBackgroundColor">#101210</Color>
    <Color x:Key="StudioSurfaceColor">#151715</Color>
    <Color x:Key="StudioSurfaceAltColor">#191B19</Color>
    <Color x:Key="StudioSurfaceRaisedColor">#222522</Color>
    <Color x:Key="StudioBorderColor">#2A2D2A</Color>
    <Color x:Key="StudioAccentColor">#45C875</Color>
    <Color x:Key="StudioAccentHoverColor">#58D486</Color>
    <Color x:Key="StudioTextPrimaryColor">#F1F3F1</Color>
    <Color x:Key="StudioTextSecondaryColor">#B7BCB8</Color>
    <Color x:Key="StudioTextMutedColor">#7E8580</Color>
    <Color x:Key="StudioErrorColor">#F07178</Color>
    <Color x:Key="StudioWarningColor">#E5C07B</Color>
    <Color x:Key="StudioSuccessColor">#66D28D</Color>
    <Color x:Key="StudioSelectionColor">#263C2D</Color>
    <Color x:Key="StudioHoverColor">#222722</Color>
    <Color x:Key="StudioSymbolColor">#BE8BEA</Color>
    <Color x:Key="StudioInfoColor">#77A9E8</Color>
    <Color x:Key="StudioMinimapColor">#6F9979</Color>

    <SolidColorBrush x:Key="StudioBackgroundBrush" Color="{StaticResource StudioBackgroundColor}" />
    <SolidColorBrush x:Key="StudioSurfaceBrush" Color="{StaticResource StudioSurfaceColor}" />
    <SolidColorBrush x:Key="StudioSurfaceAltBrush" Color="{StaticResource StudioSurfaceAltColor}" />
    <SolidColorBrush x:Key="StudioSurfaceRaisedBrush" Color="{StaticResource StudioSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="StudioBorderBrush" Color="{StaticResource StudioBorderColor}" />
    <SolidColorBrush x:Key="StudioAccentBrush" Color="{StaticResource StudioAccentColor}" />
    <SolidColorBrush x:Key="StudioAccentHoverBrush" Color="{StaticResource StudioAccentHoverColor}" />
    <SolidColorBrush x:Key="StudioTextPrimaryBrush" Color="{StaticResource StudioTextPrimaryColor}" />
    <SolidColorBrush x:Key="StudioTextSecondaryBrush" Color="{StaticResource StudioTextSecondaryColor}" />
    <SolidColorBrush x:Key="StudioTextMutedBrush" Color="{StaticResource StudioTextMutedColor}" />
    <SolidColorBrush x:Key="StudioErrorBrush" Color="{StaticResource StudioErrorColor}" />
    <SolidColorBrush x:Key="StudioWarningBrush" Color="{StaticResource StudioWarningColor}" />
    <SolidColorBrush x:Key="StudioSuccessBrush" Color="{StaticResource StudioSuccessColor}" />
    <SolidColorBrush x:Key="StudioSelectionBrush" Color="{StaticResource StudioSelectionColor}" />
    <SolidColorBrush x:Key="StudioHoverBrush" Color="{StaticResource StudioHoverColor}" />
    <SolidColorBrush x:Key="StudioSymbolBrush" Color="{StaticResource StudioSymbolColor}" />
    <SolidColorBrush x:Key="StudioInfoBrush" Color="{StaticResource StudioInfoColor}" />
    <SolidColorBrush x:Key="StudioMinimapBrush" Color="{StaticResource StudioMinimapColor}" />

    <x:Double x:Key="StudioSpace4">4</x:Double>
    <x:Double x:Key="StudioSpace8">8</x:Double>
    <x:Double x:Key="StudioSpace12">12</x:Double>
    <x:Double x:Key="StudioSpace16">16</x:Double>
    <x:Double x:Key="StudioSpace24">24</x:Double>
    <x:Double x:Key="StudioControlRadius">6</x:Double>
    <x:Double x:Key="StudioPanelRadius">8</x:Double>

    <Style x:Key="StudioPanelHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource StudioTextSecondaryBrush}" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StudioToolbarButtonStyle" TargetType="AppBarButton">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StudioCompactButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="StudioIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="StudioActivityButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="3,2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="StudioListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="StudioToolTabViewStyle" TargetType="TabView">
        <Setter Property="Background" Value="{StaticResource StudioSurfaceBrush}" />
        <Setter Property="IsAddTabButtonVisible" Value="False" />
    </Style>

    <Style x:Key="StudioEmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StudioTextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="24" />
    </Style>
</ResourceDictionary>
