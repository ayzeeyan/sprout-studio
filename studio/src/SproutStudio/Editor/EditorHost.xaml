<UserControl
    x:Class="SproutStudio.Editor.EditorHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource StudioBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="29" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TabView x:Name="DocumentTabs"
                 Grid.Row="0"
                 IsAddTabButtonVisible="True"
                 Background="{StaticResource StudioSurfaceBrush}"
                 BorderBrush="{StaticResource StudioBorderBrush}"
                 BorderThickness="0,0,0,1" />

        <Border Grid.Row="1"
                Background="{StaticResource StudioSurfaceAltBrush}"
                BorderBrush="{StaticResource StudioBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,0,5,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE838;" FontSize="11" Foreground="{StaticResource StudioAccentBrush}" />
                    <TextBlock x:Name="BreadcrumbPathText"
                               Text="untitled.spr"
                               FontSize="11"
                               Foreground="{StaticResource StudioTextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                    <Button x:Name="FormatDocumentButton"
                            Style="{StaticResource StudioIconButtonStyle}"
                            Width="27" Height="27"
                            ToolTipService.ToolTip="Format document"
                            AutomationProperties.Name="Format document">
                        <FontIcon Glyph="&#xE8D2;" FontSize="13" />
                    </Button>
                    <Button x:Name="GoToDefinitionButton"
                            Style="{StaticResource StudioIconButtonStyle}"
                            Width="27" Height="27"
                            ToolTipService.ToolTip="Go to definition (F12)"
                            AutomationProperties.Name="Go to definition">
                        <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                    </Button>
                    <Button x:Name="ToggleBreakpointButton"
                            Style="{StaticResource StudioIconButtonStyle}"
                            Width="27" Height="27"
                            ToolTipService.ToolTip="Toggle breakpoint"
                            AutomationProperties.Name="Toggle breakpoint">
                        <FontIcon Glyph="&#xEA3A;" FontSize="12" Foreground="{StaticResource StudioErrorBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource StudioSurfaceBrush}"
                    BorderBrush="{StaticResource StudioBorderBrush}"
                    BorderThickness="0,0,1,0">
                <TextBlock x:Name="LineNumbersText"
                           Padding="7,12,6,12"
                           Text="1"
                           TextAlignment="Right"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="14"
                           LineHeight="21"
                           Foreground="{StaticResource StudioTextMutedBrush}" />
            </Border>
            <TextBox x:Name="SourceEditor"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="14"
                     Padding="12,9"
                     Background="{StaticResource StudioBackgroundBrush}"
                     BorderThickness="0"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Top"
                     AutomationProperties.Name="Source code editor" />
            <Border Grid.Column="2"
                    Background="{StaticResource StudioSurfaceBrush}"
                    BorderBrush="{StaticResource StudioBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="5,10">
                <TextBlock x:Name="MinimapText"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="4"
                           Foreground="{StaticResource StudioMinimapBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Border x:Name="CompletionPopup"
                    Grid.Column="1"
                    Width="360"
                    MaxHeight="240"
                    Margin="14,0,0,14"
                    Padding="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"
                    Background="{StaticResource StudioSurfaceRaisedBrush}"
                    BorderBrush="{StaticResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <ListView x:Name="CompletionItems"
                          IsItemClickEnabled="True"
                          SelectionMode="Single"
                          ItemContainerStyle="{StaticResource StudioListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="29" Padding="7,0" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                           Foreground="{StaticResource StudioInfoBrush}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</UserControl>
