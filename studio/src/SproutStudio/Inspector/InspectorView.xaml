<UserControl
    x:Class="SproutStudio.Inspector.InspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource StudioSurfaceAltBrush}">
        <TabView x:Name="InspectorTabs"
                 Style="{StaticResource StudioToolTabViewStyle}"
                 BorderBrush="{StaticResource StudioBorderBrush}"
                 BorderThickness="1,0,0,0">
            <TabView.TabStripFooter>
                <Button x:Name="CollapsePaneButton"
                        Style="{StaticResource StudioIconButtonStyle}"
                        Width="28" Height="28" Margin="2,0,4,0"
                        ToolTipService.ToolTip="Hide Inspector"
                        AutomationProperties.Name="Hide Inspector">
                    <FontIcon Glyph="&#xE76C;" FontSize="11" />
                </Button>
            </TabView.TabStripFooter>

            <TabViewItem Header="Outline" IsClosable="False">
                <Grid>
                    <ListView x:Name="OutlineItems"
                              IsItemClickEnabled="True"
                              ItemContainerStyle="{StaticResource StudioListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="35" Padding="8,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE943;" Foreground="{StaticResource StudioSymbolBrush}" FontSize="12" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Display}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="10"
                                                   Foreground="{StaticResource StudioTextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="OutlineEmptyText"
                               Style="{StaticResource StudioEmptyStateTextStyle}"
                               Text="No symbols in the active document."
                               IsHitTestVisible="False" />
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Properties" IsClosable="False">
                <Grid Padding="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="EDITOR INSIGHT" Style="{StaticResource StudioPanelHeaderTextStyle}" />
                    <TextBlock x:Name="HoverTitleText"
                               Grid.Row="1"
                               Margin="0,9,0,3"
                               Text="Move the caret over a Sprout symbol"
                               FontWeight="SemiBold" FontSize="12"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="HoverContentsText"
                               Grid.Row="2"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource StudioTextSecondaryBrush}" />
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="COMPLETIONS" Style="{StaticResource StudioPanelHeaderTextStyle}" />
                        <ListView x:Name="CompletionItems"
                                  Grid.Row="1" Margin="0,6,0,0"
                                  ItemContainerStyle="{StaticResource StudioListViewItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="6,2">
                                        <TextBlock Text="{Binding Label}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                        <TextBlock Text="{Binding Detail}" FontSize="10"
                                                   Foreground="{StaticResource StudioTextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Debug" IsClosable="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="7,0"
                          BorderBrush="{StaticResource StudioBorderBrush}"
                          BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button x:Name="PreviousSnapshotButton"
                                    Style="{StaticResource StudioIconButtonStyle}"
                                    Width="28" Height="28"
                                    ToolTipService.ToolTip="Previous debug snapshot"
                                    AutomationProperties.Name="Previous debug snapshot">
                                <FontIcon Glyph="&#xE76B;" FontSize="11" />
                            </Button>
                            <Button x:Name="NextSnapshotButton"
                                    Style="{StaticResource StudioIconButtonStyle}"
                                    Width="28" Height="28"
                                    ToolTipService.ToolTip="Next debug snapshot"
                                    AutomationProperties.Name="Next debug snapshot">
                                <FontIcon Glyph="&#xE76C;" FontSize="11" />
                            </Button>
                            <TextBlock x:Name="DebugPositionText"
                                       Text="No debug trace"
                                       Margin="5,0,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource StudioTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Padding="9,7" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WatchNameBox" Height="29" Padding="7,2"
                                 PlaceholderText="Variable name" FontSize="11" />
                        <Button x:Name="AddWatchButton" Grid.Column="1"
                                Style="{StaticResource StudioCompactButtonStyle}"
                                MinHeight="29" Content="Add watch" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="27" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="9,0"
                              Background="{StaticResource StudioSurfaceBrush}"
                              BorderBrush="{StaticResource StudioBorderBrush}"
                              BorderThickness="0,1,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource StudioPanelHeaderTextStyle}" />
                            <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource StudioPanelHeaderTextStyle}" />
                            <TextBlock Grid.Column="2" Text="Value" Style="{StaticResource StudioPanelHeaderTextStyle}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView x:Name="VariableItems"
                                      ItemContainerStyle="{StaticResource StudioListViewItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="27" Padding="7,1" ColumnSpacing="7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding TypeName}" FontSize="10"
                                                       Foreground="{StaticResource StudioTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="VariablesEmptyText"
                                       Style="{StaticResource StudioEmptyStateTextStyle}"
                                       Text="Start debugging to inspect variables."
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>

                    <Expander Grid.Row="3" Header="CALL STACK" IsExpanded="True"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,1,0,0">
                        <ListView x:Name="CallStackItems" MaxHeight="110"
                                  FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                  ItemContainerStyle="{StaticResource StudioListViewItemStyle}" />
                    </Expander>
                    <Expander Grid.Row="4" Header="BREAKPOINTS" IsExpanded="True"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,1,0,0">
                        <ListView x:Name="BreakpointItems" MaxHeight="110"
                                  FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                  ItemContainerStyle="{StaticResource StudioListViewItemStyle}" />
                    </Expander>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Canvas" IsClosable="False">
                <Grid Background="{StaticResource StudioBackgroundBrush}">
                    <Canvas x:Name="CanvasSurface"
                            Width="300" Height="460"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="8"
                            Background="{StaticResource StudioBackgroundBrush}" />
                    <TextBlock x:Name="CanvasEmptyText"
                               Style="{StaticResource StudioEmptyStateTextStyle}"
                               Text="Run canvas_clear, canvas_rect, or canvas_circle to draw."
                               IsHitTestVisible="False" />
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</UserControl>
