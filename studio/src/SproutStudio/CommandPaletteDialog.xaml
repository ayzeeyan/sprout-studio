<UserControl
    x:Class="SproutStudio.CommandPaletteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="590" Height="410">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="SearchBox"
                 Height="36"
                 Margin="0,0,0,8"
                 Padding="10,4"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="13"
                 PlaceholderText="> Type a command"
                 TextChanged="SearchBox_TextChanged"
                 KeyDown="SearchBox_KeyDown"
                 AutomationProperties.Name="Search commands" />
        <ListView x:Name="CommandList"
                  Grid.Row="1"
                  IsItemClickEnabled="True"
                  ItemClick="CommandList_ItemClick"
                  SelectionMode="Single"
                  ItemContainerStyle="{StaticResource StudioListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="34" Padding="8,2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Display}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Shortcut}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                   Foreground="{StaticResource StudioTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
