<UserControl
    x:Class="SproutStudio.Workspace.ExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource StudioSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="12,0,5,0">
            <TextBlock Text="EXPLORER" Style="{StaticResource StudioPanelHeaderTextStyle}" />
            <Button x:Name="CollapsePaneButton"
                    Style="{StaticResource StudioIconButtonStyle}"
                    Width="27" Height="27"
                    HorizontalAlignment="Right"
                    ToolTipService.ToolTip="Hide Explorer (Ctrl+B)"
                    AutomationProperties.Name="Hide Explorer">
                <FontIcon Glyph="&#xE76B;" FontSize="12" />
            </Button>
        </Grid>

        <TextBox x:Name="WorkspaceFilterBox"
                 Grid.Row="1"
                 Height="30"
                 Margin="8,3,8,7"
                 Padding="8,2"
                 FontSize="12"
                 PlaceholderText="Filter workspace"
                 AutomationProperties.Name="Filter workspace files" />

        <Grid Grid.Row="2" Height="27" Padding="12,0,7,0" Background="{StaticResource StudioSurfaceAltBrush}">
            <TextBlock x:Name="ProjectNameText"
                       Text="SINGLE FILE"
                       Style="{StaticResource StudioPanelHeaderTextStyle}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView x:Name="WorkspaceFileList"
                      IsItemClickEnabled="True"
                      SelectionMode="Single"
                      ItemContainerStyle="{StaticResource StudioListViewItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26" Padding="8,0,4,0" ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{StaticResource StudioAccentBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RelativePath}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="WorkspaceEmptyText"
                       Style="{StaticResource StudioEmptyStateTextStyle}"
                       Text="Open or create a project to begin."
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />
        </Grid>

        <Expander x:Name="OutlineSection" Grid.Row="4" IsExpanded="True"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,1,0,0">
            <Expander.Header>
                <TextBlock Text="OUTLINE" Style="{StaticResource StudioPanelHeaderTextStyle}" />
            </Expander.Header>
            <ListView x:Name="OutlineList"
                      MaxHeight="170"
                      IsItemClickEnabled="True"
                      ItemContainerStyle="{StaticResource StudioListViewItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="25" Padding="8,0" ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE943;" Foreground="{StaticResource StudioSymbolBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Expander>

        <Expander x:Name="SourceControlSection" Grid.Row="5" IsExpanded="False"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,1,0,0">
            <Expander.Header>
                <Grid MinWidth="190">
                    <TextBlock Text="SOURCE CONTROL" Style="{StaticResource StudioPanelHeaderTextStyle}" />
                    <Button x:Name="RefreshSourceControlButton"
                            Style="{StaticResource StudioIconButtonStyle}"
                            Width="26" Height="26"
                            HorizontalAlignment="Right"
                            ToolTipService.ToolTip="Refresh source control"
                            AutomationProperties.Name="Refresh source control">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </Grid>
            </Expander.Header>
            <StackPanel Padding="9,3,9,8" Spacing="5">
                <TextBlock x:Name="BranchText"
                           Text="No repository loaded"
                           Foreground="{StaticResource StudioSuccessBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <ListView x:Name="SourceControlList"
                          MaxHeight="125"
                          FontFamily="Cascadia Mono, Consolas"
                          FontSize="11"
                          ItemContainerStyle="{StaticResource StudioListViewItemStyle}" />
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
