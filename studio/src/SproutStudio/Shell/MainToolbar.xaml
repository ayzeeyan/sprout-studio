<UserControl
    x:Class="SproutStudio.Shell.MainToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CommandBar Height="46"
                Background="{StaticResource StudioSurfaceAltBrush}"
                BorderBrush="{StaticResource StudioBorderBrush}"
                BorderThickness="0,0,0,1"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True"
                OverflowButtonVisibility="Auto">
        <CommandBar.Content>
            <Button x:Name="ProjectSelectorButton"
                    Height="32"
                    MinWidth="168"
                    MaxWidth="230"
                    Margin="8,0,10,0"
                    Padding="10,0"
                    CornerRadius="6"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Select project">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                    <TextBlock x:Name="ProjectNameText"
                               Grid.Column="1"
                               Text="Single file"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" Opacity="0.65" />
                </Grid>
            </Button>
        </CommandBar.Content>

        <AppBarButton x:Name="NewDocumentButton"
                      Style="{StaticResource StudioToolbarButtonStyle}"
                      Icon="Add" Label="New" ToolTipService.ToolTip="New document" />
        <AppBarButton x:Name="OpenDocumentButton"
                      Style="{StaticResource StudioToolbarButtonStyle}"
                      Icon="OpenFile" Label="Open" ToolTipService.ToolTip="Open file" />
        <AppBarButton x:Name="SaveDocumentButton"
                      Style="{StaticResource StudioToolbarButtonStyle}"
                      Icon="Save" Label="Save" ToolTipService.ToolTip="Save (Ctrl+S)" />
        <AppBarSeparator />
        <AppBarButton x:Name="NewProjectButton"
                      Style="{StaticResource StudioToolbarButtonStyle}"
                      Icon="NewFolder" Label="New Project" />
        <AppBarButton x:Name="OpenProjectButton"
                      Style="{StaticResource StudioToolbarButtonStyle}"
                      Icon="OpenFile" Label="Open Project" />
        <AppBarSeparator />
        <AppBarElementContainer>
            <StackPanel Orientation="Horizontal" Spacing="7" Margin="7,0">
                <TextBlock Text="Syntax"
                           FontSize="11"
                           Foreground="{StaticResource StudioTextMutedBrush}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="SyntaxProfileBox"
                          Width="108"
                          Height="32"
                          FontSize="12"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="Guided" />
                    <ComboBoxItem Content="Structured" />
                    <ComboBoxItem Content="Advanced" />
                </ComboBox>
            </StackPanel>
        </AppBarElementContainer>
        <AppBarSeparator />
        <AppBarButton x:Name="CheckButton"
                      Style="{StaticResource StudioToolbarButtonStyle}"
                      Icon="Accept" Label="Check" />
        <AppBarButton x:Name="RunButton"
                      Style="{StaticResource StudioToolbarButtonStyle}"
                      Icon="Play" Label="Run" Foreground="{StaticResource StudioSuccessBrush}" />
        <AppBarButton x:Name="DebugButton"
                      Style="{StaticResource StudioToolbarButtonStyle}"
                      Label="Debug">
            <AppBarButton.Icon>
                <FontIcon Glyph="&#xE7C9;" FontSize="16" />
            </AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton x:Name="BuildButton"
                      Style="{StaticResource StudioToolbarButtonStyle}"
                      Label="Build">
            <AppBarButton.Icon>
                <FontIcon Glyph="&#xE90F;" FontSize="16" />
            </AppBarButton.Icon>
        </AppBarButton>
    </CommandBar>
</UserControl>
