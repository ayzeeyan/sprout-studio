<UserControl
    x:Class="SproutStudio.Shell.StatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Height="24"
            Background="{StaticResource StudioSurfaceBrush}"
            BorderBrush="{StaticResource StudioBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="9,0">
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8BE;" FontSize="12" Foreground="{StaticResource StudioSuccessBrush}" />
                <TextBlock Text="Sprout · READY" FontSize="11" Foreground="{StaticResource StudioSuccessBrush}" />
                <Border Width="1" Height="12" Margin="3,0" Background="{StaticResource StudioBorderBrush}" />
                <TextBlock x:Name="TaskText" Text="No active task" FontSize="11"
                           Foreground="{StaticResource StudioTextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="CaretText" Text="Ln 1, Col 1" FontSize="11" />
                <TextBlock Text="Spaces: 4" FontSize="11" Foreground="{StaticResource StudioTextSecondaryBrush}" />
                <TextBlock Text="UTF-8" FontSize="11" Foreground="{StaticResource StudioTextSecondaryBrush}" />
                <TextBlock Text="LF" FontSize="11" Foreground="{StaticResource StudioTextSecondaryBrush}" />
                <TextBlock x:Name="LanguageText" Text="Sprout" FontSize="11" />
                <TextBlock x:Name="BranchText" Text="main" FontSize="11" Foreground="{StaticResource StudioTextSecondaryBrush}" />
                <ProgressRing x:Name="OperationProgress" Width="14" Height="14" IsActive="False" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
