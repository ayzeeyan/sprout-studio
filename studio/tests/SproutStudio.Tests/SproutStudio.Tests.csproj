<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <NativeCargoArguments Condition="'$(Configuration)' == 'Release'">--release --locked</NativeCargoArguments>
    <NativeCargoArguments Condition="'$(Configuration)' != 'Release'">--locked</NativeCargoArguments>
    <NativeCargoDirectory Condition="'$(Configuration)' == 'Release'">release</NativeCargoDirectory>
    <NativeCargoDirectory Condition="'$(Configuration)' != 'Release'">debug</NativeCargoDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SproutStudio.Academy\SproutStudio.Academy.csproj" />
    <ProjectReference Include="..\..\src\SproutStudio.Core\SproutStudio.Core.csproj" />
    <ProjectReference Include="..\..\src\SproutStudio.Editor\SproutStudio.Editor.csproj" />
    <ProjectReference Include="..\..\src\SproutStudio.Interop\SproutStudio.Interop.csproj" />
    <ProjectReference Include="..\..\src\SproutStudio.Toolchains\SproutStudio.Toolchains.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\SproutStudio.Desktop\Services\UpdateService.cs" Link="Services\UpdateService.cs" />
    <Compile Include="..\..\src\SproutStudio.Desktop\Services\StudioLog.cs" Link="Services\StudioLog.cs" />
    <Compile Include="..\..\src\SproutStudio.Desktop\Services\AcademyExecutionService.cs" Link="Services\AcademyExecutionService.cs" />
  </ItemGroup>
  <Target Name="BuildSproutNativeForTests"
          BeforeTargets="Build"
          DependsOnTargets="PrepareAndCopySproutPythonForTests">
    <Exec Command="cargo build -p sprout-ffi $(NativeCargoArguments)" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\.." />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\..\target\$(NativeCargoDirectory)\sprout_ffi.dll"
          DestinationFolder="$(OutDir)" />
  </Target>
  <Target Name="PrepareAndCopySproutPythonForTests" BeforeTargets="Build">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(SproutPreparePythonScript)&quot; -Destination &quot;$(SproutPythonRuntimeDirectory)&quot;" />
    <ItemGroup>
      <BundledPythonFile Include="$(SproutPythonRuntimeDirectory)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledPythonFile)"
          DestinationFiles="@(BundledPythonFile-&gt;'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="BuildSproutStudioForStartupTest"
          BeforeTargets="Build"
          Condition="'$(BuildingSolutionFile)' != 'true'">
    <MSBuild Projects="..\..\src\SproutStudio.Desktop\SproutStudio.Desktop.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=x64" />
  </Target>
</Project>
